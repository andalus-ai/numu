<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-construction</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-construction-adapter</artifactId>
    <name>Numou Construction - Adapter</name>
    <description>
        Infrastructure and in-memory adapter implementations for Construction SPI ports.
    </description>

    <properties>
        <!--
            The four *IntegrationTest classes boot @QuarkusTest and talk to a real
            PostgreSQL (Quarkus Dev Services needs Docker) with the bundle migrations
            already applied. That environment is not present in a plain `mvn install`,
            so by default surefire excludes them and only runs the hermetic unit tests.
            To run the PostgreSQL integration suite, provision a migrated database and
            build with: mvn -Ppg-integration verify
        -->
        <pg.integration.excludes>**/*IntegrationTest.java</pg.integration.excludes>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-construction-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-construction-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-construction-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Construction integrates with Document through its application port only. -->
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-document</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-document-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-scope-postgres-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            Postgres adapter stack (phase1 BOQ revision / idempotency / outbox).
            Dependencies only, deliberately NO quarkus-maven-plugin: this module
            stays a plain library jar like reliability-adapter, so build-time
            CDI augmentation (and its failures) never runs here.
        -->
        <dependency>
            <groupId>io.smallrye.reactive</groupId>
            <artifactId>mutiny</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-reactive-pg-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <excludes>
                        <exclude>${pg.integration.excludes}</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Opt-in PostgreSQL integration suite: requires a reachable, migrated database. -->
            <id>pg-integration</id>
            <properties>
                <!-- A pattern that matches nothing, so no *IntegrationTest is excluded. -->
                <pg.integration.excludes>__none__</pg.integration.excludes>
            </properties>
        </profile>
    </profiles>
</project>