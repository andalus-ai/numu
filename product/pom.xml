    <modules>
        <module>product-domain</module>
        <module>product-spi</module>
        <module>product-application</module>
        <module>product-adapter</module>
        <module>product-catalog</module>
        <!--
            product-runtime is intentionally NOT in the reactor: it is the
            pre-existing all-in-one Quarkus prototype (com.saas.product.*)
            whose model duplicates Product 1.0 and whose test suite was
            already failing before Product 1.0 existed. See this module's
            README, "Legacy modules". It is added back only once its
            duplicate model is migrated to numou-product-domain and its
            REST/persistence concerns are split out.
        -->
    </modules>
