<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-ecosystem</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-ecosystem-domain</artifactId>

    <name>Numou Ecosystem - Domain</name>
    <description>
        Pure Java ecosystem model: Participant, Capability,
        ProviderCapability, ParticipantRelationship, EcosystemContract.
        Depends only on numou-foundation - no framework, no Mutiny,
        no persistence annotations.
    </description>

    <dependencies>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation-testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
