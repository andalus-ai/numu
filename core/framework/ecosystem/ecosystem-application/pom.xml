<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-ecosystem</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-ecosystem-application</artifactId>

    <name>Numou Ecosystem - Application</name>
    <description>
        CQRS use cases over the ecosystem domain: register a participant,
        publish a capability, declare a provider capability, establish a
        participant relationship, record an ecosystem contract. Owns the
        outbound port interfaces implemented by infrastructure adapters.
    </description>

    <dependencies>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-ecosystem-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation-testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
