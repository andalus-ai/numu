{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:numou:platform:application:v1alpha1",
  "title": "Numou Application Manifest v1alpha1",
  "description": "Declarative, non-executable application composition manifest. It declares requirements and contributions; it does not grant permissions or execute package code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "requires"
  ],
  "properties": {
    "apiVersion": {
      "const": "platform.numou/v1alpha1"
    },
    "kind": {
      "const": "Application"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "publisher",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 5,
          "maxLength": 180,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "publisher": {
          "type": "string",
          "minLength": 5,
          "maxLength": 180,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRequirement"
          },
          "uniqueItems": true
        },
        "optionalCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRequirement"
          },
          "uniqueItems": true
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaRef",
        "schemaVersion"
      ],
      "properties": {
        "schemaRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationContribution"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contractRange"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "contractRange": {
          "type": "string",
          "pattern": "^(\\^|~)?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "navigationContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "route",
        "requiredPermission"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "route": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240,
          "pattern": "^/[A-Za-z0-9/_:-]*$"
        },
        "requiredPermission": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*$"
        }
      }
    }
  }
}
