    <modelVersion>4.0.0</modelVersion>

    <groupId>tech.kayys.numou</groupId>
    <artifactId>numou-framework</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Kayys ERP Framework</name>
    <description>
        Modular ERP platform foundation - DDD, SOLID, CQRS.
        A pure-Java domain layer plus a reactive (Mutiny) application
        layer. No framework (Quarkus, Hibernate, Kafka, ...) is allowed
        to leak into either - enforced by ArchUnit tests in each module.
    </description>


    <modules>
        <module>bom</module>

        <!-- Technical Platform Chassis -->
        <module>foundation</module>
        <module>ecosystem</module>
        <module>event</module>
        <module>integration</module>
        <module>observability</module>
        <module>reliability</module>
        <module>cache</module>
        <module>plugin</module>
        <module>workflow</module>
        <module>scope</module>
        <module>planning</module>
        <module>aggregate</module>
    </modules>

    <properties>
