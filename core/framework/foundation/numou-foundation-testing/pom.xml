<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-foundation-modules</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-foundation-testing</artifactId>

    <name>ERP Foundation - Testing</name>
    <description>
        Reusable test doubles (FixedDomainClock) and a shared ArchUnit
        rule library (ForbiddenDependencyRules) used by downstream
        bounded-context modules to write their own architecture tests
        without duplicating the forbidden-package list. Depends on
        numou-foundation only, so it can safely be a test-scope
        dependency of any module that itself depends on the domain
        module - except numou-foundation, which would create a
        reactor cycle.
    </description>

    <dependencies>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Overrides the "test" scope from dependencyManagement: this
             module's MAIN sources (ForbiddenDependencyRules) use the
             ArchUnit API directly, so it must be a compile dependency
             here even though every other module only needs it at test
             scope. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>compile</scope>
        </dependency>

    </dependencies>

</project>
