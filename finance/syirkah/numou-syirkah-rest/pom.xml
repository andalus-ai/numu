<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-syirkah</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-syirkah-rest</artifactId>
    <name>Numou Syirkah - REST</name>
    <description>
        HTTP API for the syirkah ledger: tenant and actor come from the verified request context (never from the
        client), routine operations plus maker-checker governed operations, listings, reports and integrity audit.
        The mapping and authorization logic lives in plain Java (SyirkahApi); the JAX-RS resource is a thin shell.
    </description>

    <dependencies>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-syirkah-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-syirkah-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
