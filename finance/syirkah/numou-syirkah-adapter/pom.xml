<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-syirkah</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-syirkah-adapter</artifactId>
    <name>Numou Syirkah - Adapter</name>
    <description>
        In-memory reference adapters (repository, outbox, transactions), the bridge that posts syirkah
        movements as numou JournalEntry aggregates, and the PostgreSQL migration (db/migration/V300).
    </description>

    <dependencies>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-syirkah-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-accounting-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <!-- integration test only (SYIRKAH_PG_URL); the adapter itself depends on java.sql alone -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
