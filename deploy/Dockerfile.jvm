# Runtime image for the Quarkus fast-jar produced by `mvn -pl restaurant/restaurant-api -am package`.
# Build context: restaurant/restaurant-api/target/quarkus-app
FROM eclipse-temurin:21-jre-jammy

# Non-root, fixed uid/gid so Kubernetes runAsNonRoot and file ownership are predictable.
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app
WORKDIR /deployments
COPY --chown=10001:10001 lib/ lib/
COPY --chown=10001:10001 *.jar ./
COPY --chown=10001:10001 app/ app/
COPY --chown=10001:10001 quarkus/ quarkus/

USER 10001:10001
EXPOSE 8080 9000
# Container-aware heap; exit on OOM so the orchestrator restarts a clean process rather than a half-dead one.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -Dquarkus.http.host=0.0.0.0"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /deployments/quarkus-run.jar"]
