    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Kayys ERP Framework</name>
    <description>
        Modular ERP platform foundation - DDD, SOLID, CQRS.
        A pure-Java domain layer plus a reactive (Mutiny) application
        layer. No framework (Quarkus, Hibernate, Kafka, ...) is allowed
        to leak into either - enforced by ArchUnit tests in each module.
    </description>

    <!--
        Module tree follows Docs/Plan/base01.md §18 and §P1-22:

        Phase 1 - Platform Foundation (kernel every capability trusts)
            foundation/    kernel + domain + application + adapter + testing
            ecosystem/     participant, provider, capability, relationship, contract
            event/         domain events, envelope, outbox/inbox, publisher/subscriber
            integration/   api, webhook, connector, external-system, partner
            security/      authentication, authorization, permission, audit
            observability/ logging, tracing, metrics, health
            reliability/   idempotency, retry, outbox, inbox, failure

        Phase 2..11 - business capability layers (only those with real
        implementation are declared as reactor modules):

            commerce/      POS, kiosk                     (P2)
            product/       product, catalog               (P2)
            supply/        purchasing, supplier, sourcing (P4)
            finance/       accounting, billing, payment.. (P6)
            workforce/     HRIS, people, workforce        (P7)
            logistics/     FMS, fleet, shipment, 3PL      (P5)
            asset/         asset, maintenance, facilities (P9)
            project/       project lifecycle, cost and revenue
            budget/        budget planning, control, commitments and forecasts
            identity/      identity / tenant / party      (P1)
            corporate/     company, compliance            (P1)
            common/        communication, analytics       (cross-cutting)
    -->
    <modules>
        <module>bom</module>

        <!-- Phase 1 - platform foundation -->
        <module>foundation</module>
        <module>ecosystem</module>
        <module>event</module>
        <module>integration</module>
        <module>security</module>
        <module>observability</module>
        <module>reliability</module>
        <module>cache</module>

        <!-- Phase 1 - identity / tenant / party / corporate -->
        <module>identity</module>
        <module>corporate</module>
        <module>organization</module>
        <module>tenancy</module>

        <!-- Phases 2-11 - business capability layers -->
        <module>commerce</module>
        <module>crm</module>
        <module>support</module>
        <module>product</module>
        <module>supply</module>
        <module>finance</module>
        <module>workforce</module>
        <module>scheduling</module>
        <module>leave</module>
        <module>logistics</module>
        <module>restaurant</module>
        <module>asset</module>
        <module>project</module>
        <module>construction</module>
        <module>budget</module>

        <!-- Cross-cutting & Platform Services -->
        <module>common</module>
        <module>document</module>
        <module>plugin</module>
        <module>workflow</module>
        <module>survey</module>
    </modules>

