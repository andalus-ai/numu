<?xml version="1.0" encoding="UTF-8"?>
<!--
  Marks the numou-asset-application jar as a CDI bean archive so Quarkus
  discovers the application-layer handlers (hierarchy, document, finance)
  that are annotated with @ApplicationScoped, exactly like the other
  Numou application modules.
-->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="annotated">
</beans>