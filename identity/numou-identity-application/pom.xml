<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-identity</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-identity-application</artifactId>

    <name>ERP Identity - Application</name>
    <description>
        CQRS use cases for the Identity bounded context: RegisterUser,
        ChangeUserEmail, DeactivateUser commands; GetUserById,
        ListUsers queries. Defines the UserRepository and
        PasswordHasher ports that numou-identity-adapter implements.
        Depends on numou-identity-domain and numou-foundation-application
        only.
    </description>

    <dependencies>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-identity-domain</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- L1 caching port (Caffeine-backed in the adapter): effective-permission
             and PAT validation caches live on the hot authorization path. -->
        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-cache-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>tech.kayys.numou</groupId>
            <artifactId>numou-foundation-testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
