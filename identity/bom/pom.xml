<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-framework</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>numou-bom</artifactId>
    <packaging>pom</packaging>

    <name>Numou Platform BOM</name>
    <description>
        Version alignment for the Numou Foundation and composable
        bounded-context modules. Import this BOM in products instead of
        repeating platform and module versions.
    </description>

    <dependencyManagement>
        <dependencies>
            <!-- Platform dependencies -->
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-foundation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-foundation-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-foundation-testing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-foundation-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-security-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-security-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-security-application</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Extracted bounded contexts -->
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-identity-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-identity-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-identity-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
           

            <!-- Test and static-analysis dependencies -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
           
        </dependencies>
    </dependencyManagement>
</project>
